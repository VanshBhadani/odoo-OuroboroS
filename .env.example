# ── StockSense Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your local values.

# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stocksense_db

# JWT signing secret – change this to a long random string in production
SECRET_KEY=change-me-to-a-very-long-random-secret-key-in-production

# JWT algorithm
ALGORITHM=HS256

# JWT access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Default admin credentials seeded on first startup
ADMIN_EMAIL=admin@stocksense.local
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=System Administrator
